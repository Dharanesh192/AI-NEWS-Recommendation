{
  "version": 2,
  "builds": [
    { "src": "api/Backend.py", "use": "@vercel/python" },
    { "src": "AI_NEWS/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "^/api(/.*)?$",
      "dest": "api/Backend.py"
    },
    {
      "src": "^(?!/api).*$",
      "dest": "/AI_NEWS/index.html"
    }
  ]
}
